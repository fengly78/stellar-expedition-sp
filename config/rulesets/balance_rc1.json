    "notes": "RC1 批准冻结（2026-09-23 所有者批准 CR-002/003/004/005+经典机制组，执行记录 tools/cr_batch_apply_20260923.py）。value=null 表示 TBD 的规则不再适用——本版零 TBD。hash 按 config_validate 输出回填。 2026-09-28：F-08 由 Frozen 降级为 Candidate（线上为常量节奏公式，详见 tools/verify_f08_vs_impl.py）；本次变更前 hash=d8f1d02d8f8815021cff0d8d1c5dc47e28093dcabc2dc43850bab52373513ef9。"
  },
  "formulas": [
    {
      "id": "F-01",
      "name": "升级成本",
      "expression": "C_r(L) = ceil(C_r,1 * g^(L-1)), L>=1",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-02",
      "name": "矿场基础产量",
      "expression": "P_r(0)=0; P_r(L)=p_r*L*a_r^(L-1), L>=1",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-03",
      "name": "实际产量",
      "expression": "P_actual = P_r(L)*e*B_r; e=min(1,E_supply/E_need); E_need=0 时 e=1",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-04",
      "name": "仓容",
      "expression": "S(L)=S0+S1*(g^L-1)/(g-1), L>=0",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-05",
      "name": "内部资源估值",
      "expression": "V(M,C,D)=M+2C+3D；仅分析/AI 决策，非交易汇率",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-06",
      "name": "殖民容量与任务槽",
      "expression": "Pmax=1+ceil(A/2)；Fmax=2+ComputerLevel",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-07",
      "name": "军事科技线性增益",
      "expression": "X = X0*(1+k*L)；中心 k=0.05，测试 0.04/0.05/0.06",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-08",
      "name": "建筑时间原式",
      "expression": "T=max(T_min, ceil(3600*(M+C)/(2500*(1+R)*2^N*speed)))（上游同构式，仅线下推演用）",
      "status": "Candidate",
      "source": "V1.3 §05.2；CR-003 E 批准；f08 校准 universe_speed=1。2026-09-28 降级 Frozen->Candidate：线上实际实现是 baseTime*factor^L/SPEED/(1+R)（objects.ts buildingTime），不由造价推导、无 2^N 加速（id 34 纳米工厂未实现）、无 T_min 下限。本式仅供 rules/formulas.py 线下推演与 SIM 对照，不等于线上行为；线上常量节奏是 v1.0.0 已发布的设计，改动会破坏存量存档与全部平衡。裁决记录见 doc/governance/SOURCE-02-codecross-check-2026-09-28.md，可用 python tools/verify_f08_vs_impl.py 复核。"
    },
    {
      "id": "F-09",
      "name": "总督优势",
      "expression": "G=V_governor/V_normal-1；V_normal=0 标不可计算",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    },
    {
      "id": "F-10",
      "name": "单次袭击净收益",
      "expression": "Profit=V_loot+V_actual_recovered_debris-V_destroyed_ships-V_fuel；MVP 回收项为零",
      "status": "Candidate",
      "source": "V1.3 §05.2"
    }
  ],
