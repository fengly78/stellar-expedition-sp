<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!-- MariaDB 语义级验证档（P0-4）：真实 ENUM/行锁 FOR UPDATE/JSON/DATETIME(6)。
         用法：本机 MariaDB(便携版, 3307) 拉起后 ——
           php -d memory_limit=1G vendor/phpunit/phpunit/phpunit -c phpunit-mariadb.xml
         RefreshDatabase 每例 migrate:fresh（较慢，验证轮专用；日常仍用默认 SQLite 档）。 -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3307"/>
        <env name="DB_DATABASE" value="ogame_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
    </php>
</phpunit>
