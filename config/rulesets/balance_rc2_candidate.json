  "protection": {
    "initial_hours": 72,
    "p1_attack_ratio_limit": 3,
    "p2_attack_ratio_limit": 5,
    "open_extreme_ratio": 10,
    "aggressor_window_hours": 24,
    "repeat_attack_decay": [
      1,
      0.7,
      0.4,
      0.2,
      0.1
    ],
    "protected_resource_ratio": {
      "P1": 0.7,
      "P2": 0.45,
      "P3": 0.2
    },
    "return_shield_offline_days": 14,
    "power_score": {
      "formula": "E + R + 1.25*max(M_current,0.5*M_peak_7d) + 100000*max(0,planet_count-1)",
      "economy_value": "completed building cumulative V",
      "research_value": "completed research cumulative V",
      "military_value": "current ships+defense V",
      "anti_drop_floor": "50% of maximum military V observed in previous 7d"
    },
    "state_machine": {
      "P0": {
        "exit": "tutorial_core_complete OR account_age>=24h",
        "next": "P1"
      },
      "P1": {
        "min_until_hours": 72,
        "exit": "account_age>=72h AND core_milestones_complete",
        "next": "P2"
      },
      "P2": {
        "min_duration_hours": 48,
        "exit": "account_age>=120h AND growth_score>=open_threshold",
        "next": "P3"
      },
      "P3": {
        "open": true
      },
      "aggressor_window": {
        "duration_hours": 24,
        "recall_does_not_cancel": true
      }
    },
    "open_threshold": 100000
  },
  "autopilot_defaults": {
    "allow_pvp": false,
    "max_spend_ratio_per_action": 0.2,
    "max_fleet_commit_ratio": 0.35,
    "max_risk_score": 40,
    "actions": [
      "UPGRADE_ECONOMY",
      "QUEUE_RESEARCH",
      "QUEUE_MANUFACTURE",
      "BALANCE_RESOURCES",
      "EVACUATE_ON_ATTACK"
    ]
  },
  "validation": {
    "require_unique_ids": true,
    "require_prerequisite_dag": true,
    "require_reachable_from_new_account": true,
    "require_frozen_override_change_record": true,
    "require_ruleset_version_in_settlement": true
  },
  "combat_rules_ref": "combat_rc2_candidate.json"
}
